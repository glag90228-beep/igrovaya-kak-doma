[Unit]
Description=Трапеза Документы — мини-приложение Telegram
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/trapeza
EnvironmentFile=/opt/trapeza/.env
ExecStart=/usr/bin/node miniapp.js
Restart=always
RestartSec=5
User=trapeza
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/trapeza/data
StandardOutput=append:/var/log/trapeza/miniapp.log
StandardError=append:/var/log/trapeza/miniapp.log

[Install]
WantedBy=multi-user.target
