[Unit]
Description=Первичка — мини-приложение Telegram
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/trapeza
EnvironmentFile=/opt/trapeza/.env
ExecStart=/usr/bin/node miniapp.js
# Chromium для PDF лежит в общем каталоге, а не в домашней папке того,
# кто запускал установку: служба работает от trapeza и с ProtectHome=true
# в /root не заглянет — документы молча уходили бы клиентам в HTML.
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers
Restart=always
RestartSec=5
User=trapeza
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/trapeza/data
StandardOutput=append:/var/log/trapeza/miniapp.log
StandardError=append:/var/log/trapeza/miniapp.log

[Install]
WantedBy=multi-user.target
