# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает (.gitignore).
# chmod 600 .env — токен даёт полный доступ к боту.

# ── обязательное ──
BOT_TOKEN=

# ── поддержка и команды владельца (/grant, /who) ──
# Ваш личный chat_id. Узнать: напишите боту любое сообщение и посмотрите
# в логе строку «Обращение…», либо спросите у @userinfobot.
SUPPORT_CHAT_ID=
SUPPORT_CONTACT=@

# ── оплата через Lava Top ──
LAVA_OFFER_URL=
LAVA_WEBHOOK_SECRET=
LAVA_PLAN_DAYS=349:30,3490:365
LAVA_DEFAULT_DAYS=30
LAVA_PORT=8788
# Имя параметра, в котором площадка вернёт Telegram-id. Уточняется
# по первому настоящему вебхуку, до этого — значение по умолчанию.
LAVA_PARAM=clientUtm

# ── распознавание фото счёта (необязательно) ──
# anthropic | yandex | пусто
VISION_PROVIDER=
ANTHROPIC_API_KEY=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# ── PDF ──
# Путь к Chromium, если ставите playwright-core вместо playwright.
CHROMIUM_PATH=

# ── база ──
TRAPEZA_DB=/opt/trapeza/data/trapeza.db
