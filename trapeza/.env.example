# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает (.gitignore).
# chmod 600 .env — токен даёт полный доступ к боту.

# ── обязательное ──
BOT_TOKEN=

# ── поддержка и команды владельца (/grant, /code, /who) ──
# Ваш личный chat_id. Без него бесплатную подписку выдать нечем: команды
# владельца работают только из этого чата. Узнать свой номер: напишите боту
# /id, либо посмотрите в логе строку «Обращение…», либо спросите @userinfobot.
SUPPORT_CHAT_ID=
SUPPORT_CONTACT=@

# ── оплата через Lava Top ──
LAVA_OFFER_URL=
LAVA_WEBHOOK_SECRET=
# Тарифы: сумма платежа → дней доступа. Отсюда же берётся цена, которую
# видит человек в боте и в приложении, — чтобы они не могли разойтись.
# Суммы обязаны совпадать с товарами в Lava: платёж, не попавший в список,
# получит LAVA_DEFAULT_DAYS, то есть месяц вместо года.
LAVA_PLAN_DAYS=390:30,2990:365
# Бесплатных документов в месяц (дальше — подписка). ENFORCE_LIMIT=0 открывает всем.
FREE_DOCS=5
ENFORCE_LIMIT=1
LAVA_DEFAULT_DAYS=30
LAVA_PORT=8788
# Имя параметра, в котором площадка вернёт Telegram-id. Уточняется
# по первому настоящему вебхуку, до этого — значение по умолчанию.
LAVA_PARAM=clientUtm

# ── мини-приложение в Telegram ──
# Адрес, по которому открывается приложение. Только https — Telegram
# другие не принимает. Тот же домен, что и у приёмника оплат, годится:
# nginx отдаёт «/» приложению, «/lava» — вебхукам.
# Пусто — бот работает как раньше, кнопки приложения просто не будет.
WEBAPP_URL=
MINIAPP_PORT=8790
# Сколько секунд считать вход действительным (подпись Telegram бессрочна).
WEBAPP_TTL=86400

# ── отправка документов на почту клиенту ──
# Каждый клиент подключает СВОЙ ящик прямо в боте: письмо уходит с его
# адреса, не попадает в спам и юридически отправляет он, а не мы.
# Пароли клиентов хранятся зашифрованными этим ключом. Задайте свой
# длинный случайный: openssl rand -base64 32
#
# ЗАДАЙТЕ ЕГО ОБЯЗАТЕЛЬНО. Пустым почта не ломается — ключ выводится из
# BOT_TOKEN, и всё работает как ни в чём не бывало. Беда всплывает позже:
# при утечке токена его первым делом отзывают, а вместе с ним становятся
# нечитаемыми пароли ВСЕХ подключённых ящиков, и каждому клиенту придётся
# подключать почту заново. Отдельный ключ переживает смену токена.
#
# Менять его после запуска нельзя по той же причине: старые записи не
# прочитаются. Если всё же меняете — предупредите клиентов.
MAIL_KEY=

# Настройки ниже — общий ящик сервера. Используется ТОЛЬКО при SMTP_SHARED=1
# и только теми, кто не подключил свой. Включать не рекомендую: письма всех
# клиентов с одного адреса — прямой путь в спам и к блокировке ящика.
SMTP_SHARED=0
# Ящик, из которого уходят письма. Для Яндекса и mail.ru нужен НЕ обычный
# пароль, а «пароль приложения» — он создаётся в настройках почты.
#   Яндекс:  smtp.yandex.ru, порт 465, SMTP_SECURE=1
#   mail.ru: smtp.mail.ru,   порт 465, SMTP_SECURE=1
#   Gmail:   smtp.gmail.com, порт 587 (STARTTLS), SMTP_SECURE пусто
# Пусто — кнопка «Отправить на почту» просто не показывается.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Первичка
SMTP_SECURE=1

# ── заполнение реквизитов по ИНН и БИК (очень рекомендую) ──
# Бесплатный ключ DaData: dadata.ru → регистрация → API-ключ.
# С ним при заведении организации/контрагента достаточно ввести ИНН —
# название, адрес, КПП, директор подставятся сами; по БИК — банк и корр. счёт.
DADATA_TOKEN=

# ── распознавание фото счёта (необязательно) ──
# anthropic | yandex | пусто
VISION_PROVIDER=
ANTHROPIC_API_KEY=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# ── распознавание голосовых (необязательно) ──
# yandex | пусто. Ключ и папка — те же, что выше: заводить второй сервис не
# нужно. Но сервисному аккаунту нужна роль ai.speechkit-stt.user — сам по
# себе ключ прав на распознавание речи не даёт.
#
# Anthropic здесь нет и быть не может: Messages API принимает текст,
# картинки и PDF, а звук — нет. Голос переводит в текст SpeechKit, дальше
# фразу понимает всё та же модель, что и напечатанную.
SPEECH_PROVIDER=

# ── свободный ввод: «выставь Заре счёт за аренду» (необязательно) ──
# Выключено, пока здесь не стоит 1: ключ выше часто нужен только для
# распознавания счетов и сам по себе не должен запускать расходы.
# Документы этот разбор не выписывает — он открывает обычный мастер
# с заполненными позициями, выписывает по-прежнему человек.
AI_ENABLED=0
# anthropic | openai
AI_PROVIDER=anthropic
# Разбор фразы — простая задача, дорогая модель здесь не нужна.
AI_MODEL=claude-haiku-4-5-20251001
# Предел расхода в месяц, в копейках. Общий платит владелец бота.
# Главный кран: фраза стоит сотые доли копейки, снимок счёта — в полсотни раз
# больше, минута речи — почти в восемьдесят, а предел в штуках их не различал.
AI_MONTHLY_KOPECKS=300000
# Личный предел зависит от подписки. 50 ₽ подписчику — это около 2300 фраз,
# 54 снимка или 40 минут речи при подписке 390 ₽.
AI_USER_KOPECKS=5000
# Без подписки — доля: попробовать можно, жить на ней нельзя. 5 ₽ — это
# примерно 230 фраз или 5 снимков.
AI_FREE_KOPECKS=500
# Пределы обращений в месяц — второй рубеж, на случай когда провайдер не
# вернул расход и стоимость посчиталась нулём.
AI_MONTHLY_LIMIT=1000
AI_USER_LIMIT=30
AI_FREE_LIMIT=10
# Цены провайдера в копейках. Здесь, а не в коде: меняются несколько раз в год.
# Проверьте у своего — умолчания это порядок величины, а не прайс.
# Прикинуть расход и остаток от подписки: node tools/ai-cost.js
AI_KOP_IN=1200
AI_KOP_OUT=4800
AI_KOP_CACHED=120
AI_KOP_PHOTO=90
AI_KOP_VOICE=120

# ── ответы по налогам (блок «Агент») ──
# Бот отвечает на налоговые вопросы: сначала по своей проверенной базе
# (lib/knowledge.js) — там у каждого ответа есть норма НК РФ. База работает
# всегда и этой переменной не управляется.
#
# Эта переменная про другое: отвечать ли МОДЕЛЬЮ на то, чего в базе нет.
# Такой ответ помечается «мы это не сверяли», но всё равно остаётся ответом
# про налоги, и ошибка в нём стоит штрафа человеку.
#
# По умолчанию выключено. Включайте, только когда:
#   1) сверили записи базы с nalog.gov.ru — при написании они собраны по
#      нормам НК, но сверить было нечем: сайт из среды разработки недоступен;
#   2) в оферте прописано, что справки даются без гарантий.
AI_TAX_ANSWERS=0
# Поиск ответа на официальных сайтах — ступень между базой и памятью модели.
# С ним в ответе стоит адрес страницы ФНС или Минфина, а не «отвечала модель».
#
# yandex | mock | пусто. Ключ и каталог — те же, что у речи и фото.
# Ищем только по белому списку (lib/search.js): ФНС, Минфин, pravo.gov.ru,
# СФР, Верховный Суд. Бухгалтерские блоги отбрасываются, даже если они первые
# в выдаче: пишут бойко, часто верно и почти всегда без даты, а ставки с тех
# пор поменялись дважды.
SEARCH_PROVIDER=

# ── PDF ──
# Путь к Chromium, если ставите playwright-core вместо playwright.
CHROMIUM_PATH=

# ── база ──
TRAPEZA_DB=/opt/trapeza/data/trapeza.db

# ── резервные копии базы ──
# Снимаются каждую ночь (systemd-таймер trapeza-backup.timer).
BACKUP_DIR=/var/backups/trapeza
BACKUP_KEEP=14
# Отправлять копию владельцу в Telegram — тогда данные переживут смерть
# диска. В копии лежат данные клиентов, поэтому по умолчанию выключено.
BACKUP_TO_TELEGRAM=0
