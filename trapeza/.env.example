# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает (.gitignore).
# chmod 600 .env — токен даёт полный доступ к боту.

# ── обязательное ──
BOT_TOKEN=

# ── поддержка и команды владельца (/grant, /who) ──
# Ваш личный chat_id. Узнать: напишите боту любое сообщение и посмотрите
# в логе строку «Обращение…», либо спросите у @userinfobot.
SUPPORT_CHAT_ID=
SUPPORT_CONTACT=@

# ── оплата через Lava Top ──
LAVA_OFFER_URL=
LAVA_WEBHOOK_SECRET=
LAVA_PLAN_DAYS=349:30,3490:365
# Бесплатных документов в месяц (дальше — подписка). ENFORCE_LIMIT=0 открывает всем.
FREE_DOCS=5
ENFORCE_LIMIT=1
LAVA_DEFAULT_DAYS=30
LAVA_PORT=8788
# Имя параметра, в котором площадка вернёт Telegram-id. Уточняется
# по первому настоящему вебхуку, до этого — значение по умолчанию.
LAVA_PARAM=clientUtm

# ── мини-приложение в Telegram ──
# Адрес, по которому открывается приложение. Только https — Telegram
# другие не принимает. Тот же домен, что и у приёмника оплат, годится:
# nginx отдаёт «/» приложению, «/lava» — вебхукам.
# Пусто — бот работает как раньше, кнопки приложения просто не будет.
WEBAPP_URL=
MINIAPP_PORT=8790
# Сколько секунд считать вход действительным (подпись Telegram бессрочна).
WEBAPP_TTL=86400

# ── отправка документов на почту клиенту ──
# Ящик, из которого уходят письма. Для Яндекса и mail.ru нужен НЕ обычный
# пароль, а «пароль приложения» — он создаётся в настройках почты.
#   Яндекс:  smtp.yandex.ru, порт 465, SMTP_SECURE=1
#   mail.ru: smtp.mail.ru,   порт 465, SMTP_SECURE=1
#   Gmail:   smtp.gmail.com, порт 587 (STARTTLS), SMTP_SECURE пусто
# Пусто — кнопка «Отправить на почту» просто не показывается.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Первичка
SMTP_SECURE=1

# ── заполнение реквизитов по ИНН и БИК (очень рекомендую) ──
# Бесплатный ключ DaData: dadata.ru → регистрация → API-ключ.
# С ним при заведении организации/контрагента достаточно ввести ИНН —
# название, адрес, КПП, директор подставятся сами; по БИК — банк и корр. счёт.
DADATA_TOKEN=

# ── распознавание фото счёта (необязательно) ──
# anthropic | yandex | пусто
VISION_PROVIDER=
ANTHROPIC_API_KEY=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# ── PDF ──
# Путь к Chromium, если ставите playwright-core вместо playwright.
CHROMIUM_PATH=

# ── база ──
TRAPEZA_DB=/opt/trapeza/data/trapeza.db
